# Frontend values used by `npm run dev:frontend`
PUBLIC_API_URL=https://script.google.com/macros/s/REPLACE_WITH_LOCAL_WEB_APP_DEPLOYMENT_ID/exec
PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_LOCAL_TURNSTILE_SITE_KEY

# GAS values used by `npm run gas:push:local` and `npm run gas:deploy:local`
GAS_SCRIPT_ID=REPLACE_WITH_LOCAL_GAS_SCRIPT_ID
GAS_TURNSTILE_SECRET=REPLACE_WITH_LOCAL_TURNSTILE_SECRET
GAS_PUBLIC_SITE_URL=http://localhost:4321
GAS_ENFORCE_CAPTCHA=true
GAS_ENFORCE_ACCESS_CONTROL=true
GAS_DEPLOYMENT_DESCRIPTION=shortyou-local

# Optional
# GAS_DEPLOYMENT_ID=REPLACE_WITH_EXISTING_LOCAL_DEPLOYMENT_ID
# GAS_SHORT_LINKS_SHEET_NAME=short_links_local
# GAS_CLIENTS_SHEET_NAME=clients_local
# GAS_AUDIT_LOGS_SHEET_NAME=audit_logs_local
# GAS_DEFAULT_DAILY_QUOTA=0
# GAS_RESERVED_ALIASES=admin,api
# GAS_MAX_URL_LENGTH=2048
# GAS_RANDOM_ALIAS_INITIAL_LENGTH=6
# GAS_RANDOM_ALIAS_MAX_LENGTH=12
# GAS_RANDOM_ALIAS_TRY_PER_LENGTH=12
# GAS_CAPABILITY_TOKEN_LENGTH=64