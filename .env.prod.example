# Frontend values used by `npm run build:frontend`
PUBLIC_API_URL=https://script.google.com/macros/s/REPLACE_WITH_PRODUCTION_WEB_APP_DEPLOYMENT_ID/exec
PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_PRODUCTION_TURNSTILE_SITE_KEY

# GAS values used by `npm run gas:push:production` and `npm run gas:deploy:production`
GAS_SCRIPT_ID=REPLACE_WITH_PRODUCTION_GAS_SCRIPT_ID
GAS_TURNSTILE_SECRET=REPLACE_WITH_PRODUCTION_TURNSTILE_SECRET
GAS_PUBLIC_SITE_URL=https://s.purr.tw
GAS_ENFORCE_CAPTCHA=true
GAS_ENFORCE_ACCESS_CONTROL=true
GAS_DEPLOYMENT_DESCRIPTION=shortyou-production

# Optional
# GAS_DEPLOYMENT_ID=REPLACE_WITH_EXISTING_PRODUCTION_DEPLOYMENT_ID
# GAS_SHORT_LINKS_SHEET_NAME=short_links
# GAS_CLIENTS_SHEET_NAME=clients
# GAS_AUDIT_LOGS_SHEET_NAME=audit_logs
# GAS_DEFAULT_DAILY_QUOTA=0
# GAS_RESERVED_ALIASES=admin,api
# GAS_MAX_URL_LENGTH=2048
# GAS_RANDOM_ALIAS_INITIAL_LENGTH=6
# GAS_RANDOM_ALIAS_MAX_LENGTH=12
# GAS_RANDOM_ALIAS_TRY_PER_LENGTH=12
# GAS_CAPABILITY_TOKEN_LENGTH=64