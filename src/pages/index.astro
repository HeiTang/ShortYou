---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ShortYou ฅ•ω•ฅ</title>
    <meta
      name="description"
      content="ShortYou is a URL Shortener."
    />
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
    <link rel="canonical" href="https://t.purr.tw/" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen bg-zinc-900 text-slate-100">
    <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col px-4 py-5">
      <header class="mb-auto flex items-center justify-between gap-2">
        <h3 class="brand-font shrink-0 text-xl leading-none sm:text-2xl">ShortYou</h3>
        <nav class="flex items-center gap-2 whitespace-nowrap text-[11px] text-slate-300 sm:gap-4 sm:text-sm">
          <a href="/" class="text-white">URL</a>
          <a href="/invite" class="transition hover:text-white">Invite</a>
          <a href="https://github.com/HeiTang" target="_blank" rel="noreferrer" aria-label="GitHub" class="inline-flex items-center transition hover:text-white">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4">
              <path d="M12 .5C5.65.5.5 5.73.5 12.18c0 5.16 3.3 9.53 7.88 11.08.58.11.79-.26.79-.57 0-.28-.01-1.04-.02-2.04-3.2.71-3.88-1.57-3.88-1.57-.52-1.36-1.28-1.72-1.28-1.72-1.04-.73.08-.72.08-.72 1.15.08 1.75 1.2 1.75 1.2 1.02 1.77 2.68 1.26 3.33.97.1-.75.4-1.26.72-1.55-2.56-.3-5.25-1.3-5.25-5.79 0-1.28.45-2.33 1.18-3.16-.12-.3-.51-1.51.11-3.14 0 0 .97-.32 3.17 1.21a10.8 10.8 0 0 1 5.77 0c2.19-1.53 3.16-1.21 3.16-1.21.63 1.63.24 2.84.12 3.14.73.83 1.17 1.88 1.17 3.16 0 4.5-2.7 5.49-5.28 5.79.41.36.77 1.08.77 2.17 0 1.57-.01 2.83-.01 3.22 0 .31.2.69.8.57a11.72 11.72 0 0 0 7.87-11.08C23.5 5.73 18.35.5 12 .5Z"></path>
            </svg>
          </a>
        </nav>
      </header>

      <section id="redirectPanel" class="mb-4 hidden border border-slate-600 bg-slate-800 px-4 py-3 text-sm text-slate-200">
        Redirecting...
      </section>

      <section class="mx-auto my-8 w-full max-w-xl text-center">
        <h1 class="title-font mb-12 text-6xl leading-none md:text-8xl">
          Just&nbsp;Shorten&nbsp;It
          <span class="block">ヽ(‘ ∇‘ )ノ</span>
        </h1>
        <p class="title-font mb-7 text-3xl text-slate-200 md:text-4xl">
          <span
            class="txt-rotate"
            data-period="1000"
            data-rotate='["Too Long ? ", "Too Height ? ", "Too Fat ? ", "Too Ugly ? ", "30cm ? "]'
          >You</span>
          Shorten it !
        </p>

        <div class="mx-auto w-full max-w-xl space-y-3">
          <div class="url-row">
            <input
              id="url"
              type="text"
              placeholder="https://purr.tw"
              aria-label="Target URL"
              autocomplete="off"
              class="flat-input url-input"
            />
            <div class="url-actions">
              <button
                id="aliasToggle"
                type="button"
                class="icon-btn"
                aria-label="Toggle custom alias"
                aria-controls="aliasPanel"
                aria-expanded="false"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4">
                  <circle cx="12" cy="12" r="3.2"></circle>
                  <path d="M19.4 15a1 1 0 0 0 .2 1.1l.1.1a2 2 0 0 1 0 2.8 2 2 0 0 1-2.8 0l-.1-.1a1 1 0 0 0-1.1-.2 1 1 0 0 0-.6.9V20a2 2 0 0 1-4 0v-.2a1 1 0 0 0-.7-.9 1 1 0 0 0-1 .2l-.2.1a2 2 0 1 1-2.8-2.8l.1-.1a1 1 0 0 0 .2-1.1 1 1 0 0 0-.9-.6H4a2 2 0 0 1 0-4h.2a1 1 0 0 0 .9-.7 1 1 0 0 0-.2-1l-.1-.2a2 2 0 1 1 2.8-2.8l.1.1a1 1 0 0 0 1.1.2 1 1 0 0 0 .6-.9V4a2 2 0 0 1 4 0v.2a1 1 0 0 0 .7.9 1 1 0 0 0 1-.2l.2-.1a2 2 0 1 1 2.8 2.8l-.1.1a1 1 0 0 0-.2 1.1 1 1 0 0 0 .9.6H20a2 2 0 0 1 0 4h-.2a1 1 0 0 0-.9.7z"></path>
                </svg>
              </button>
              <button id="btn" class="flat-btn flat-btn-inline hidden" disabled>Shorten</button>
            </div>
          </div>
          <div id="aliasPanel" class="alias-panel is-collapsed">
            <div id="aliasWrap" class="alias-shell is-disabled">
              <span class="alias-prefix">#</span>
              <input
                id="alias"
                type="text"
                placeholder="Customize link (optional)"
                aria-label="Custom alias"
                autocomplete="off"
                class="alias-input"
              />
            </div>
          </div>

          <p class="text-xs text-slate-400">Playground only, not persisted to backend.</p>
          <p id="result" class="mt-3 break-all text-sm text-cyan-300"></p>
        </div>
      </section>

      <footer class="mt-auto text-center text-xs text-slate-400">
        Copyright © <span data-current-year></span> <a href="https://github.com/HeiTang" class="underline underline-offset-2">黑糖不是炭</a>. All rights reserved.
      </footer>
    </main>

    <script>
      window.__SHORTYOU_CONFIG__ = {
        api: atob('aHR0cHM6Ly9zY3JpcHQuZ29vZ2xlLmNvbS9tYWNyb3Mvcy9BS2Z5Y2J6X2JXbW1LWWJmb0xjTmEzeWttUG9weUc5dmFEWTZkMWRtc2R4WHY3U0VRVF9vTFhETlEwZE5xb2NlQlVvbGpvNUkvZXhlYw==')
      };
    </script>
    <script type="module">
      const api = window.__SHORTYOU_CONFIG__.api;
      const pageBase = `${window.location.origin}${window.location.pathname}`;
      const hash = decodeURIComponent((window.location.hash || '').replace(/^#/, ''));
      const yearNode = document.querySelector('[data-current-year]');
      if (yearNode) yearNode.textContent = String(new Date().getFullYear());

      const redirectPanel = document.getElementById('redirectPanel');
      const inp = document.getElementById('url');
      const ali = document.getElementById('alias');
      const aliasToggle = document.getElementById('aliasToggle');
      const aliasPanel = document.getElementById('aliasPanel');
      const aliasWrap = document.getElementById('aliasWrap');
      const btn = document.getElementById('btn');
      const resultNode = document.getElementById('result');
      const storageKey = 'shortyou_fake_links';
      let aliasOpen = false;

      const readStore = () => {
        try {
          const raw = localStorage.getItem(storageKey);
          return raw ? JSON.parse(raw) : {};
        } catch {
          return {};
        }
      };

      const writeStore = (data) => {
        localStorage.setItem(storageKey, JSON.stringify(data));
      };

      const randomAlias = (len = 6) => {
        const chars = 'abcdefghijklmnopqrstuvwxyz0123456789';
        let out = '';
        for (let i = 0; i < len; i += 1) out += chars.charAt(Math.floor(Math.random() * chars.length));
        return out;
      };

      const generateAlias = (requested) => {
        const table = readStore();
        const base = requested || randomAlias();
        if (!table[base]) return base;
        let idx = 2;
        while (table[`${base}-${idx}`]) idx += 1;
        return `${base}-${idx}`;
      };

      if (hash.startsWith('t=')) {
        window.location.href = `/invite#${hash}`;
      } else if (hash) {
        redirectPanel.classList.remove('hidden');
        const table = readStore();
        if (table[hash]) {
          window.location.href = table[hash];
        } else {
          fetch(`${api}?query=${encodeURIComponent(hash)}`)
            .then((r) => r.json())
            .then((j) => {
              window.location.href = j && j.success && j.result ? j.result : pageBase;
            })
            .catch(() => {
              window.location.href = pageBase;
            });
        }
      }

      const setAliasOpen = (open) => {
        aliasOpen = !!open;
        aliasPanel.classList.toggle('is-open', aliasOpen);
        aliasPanel.classList.toggle('is-collapsed', !aliasOpen);
        aliasToggle.setAttribute('aria-expanded', String(aliasOpen));
      };

      const updatePlaygroundState = () => {
        const valid = inp.value.trim().startsWith('http');
        const aliasEnabled = aliasOpen;
        ali.disabled = !aliasEnabled;
        aliasWrap.classList.toggle('is-disabled', !aliasEnabled);
        btn.classList.toggle('hidden', !valid);
        btn.disabled = !valid;
      };

      inp.addEventListener('input', updatePlaygroundState);
      aliasToggle.addEventListener('click', () => {
        setAliasOpen(!aliasOpen);
        updatePlaygroundState();
      });
      updatePlaygroundState();

      btn.addEventListener('click', () => {
        const url = inp.value.trim();
        if (!url.startsWith('http')) return;

        const table = readStore();
        const requested = aliasOpen ? ali.value.trim().toLowerCase().replace(/\s+/g, '-') : '';
        const alias = generateAlias(requested);
        table[alias] = url;
        writeStore(table);
        resultNode.innerText = `${pageBase}#${alias}`;
      });

      const TxtRotate = function (el, toRotate, period) {
        this.toRotate = toRotate;
        this.el = el;
        this.loopNum = 0;
        this.period = parseInt(period, 10) || 2000;
        this.txt = '';
        this.tick();
        this.isDeleting = false;
      };

      TxtRotate.prototype.tick = function () {
        const i = this.loopNum % this.toRotate.length;
        const fullTxt = this.toRotate[i];
        this.txt = this.isDeleting
          ? fullTxt.substring(0, this.txt.length - 1)
          : fullTxt.substring(0, this.txt.length + 1);
        this.el.innerHTML = this.txt;
        let delta = this.isDeleting ? 100 : 200;
        if (!this.isDeleting && this.txt === fullTxt) {
          delta = this.period;
          this.isDeleting = true;
        } else if (this.isDeleting && this.txt === '') {
          this.isDeleting = false;
          this.loopNum += 1;
          delta = 400;
        }
        setTimeout(() => this.tick(), delta);
      };

      window.addEventListener('load', () => {
        const elements = document.getElementsByClassName('txt-rotate');
        for (let i = 0; i < elements.length; i += 1) {
          const rotateData = elements[i].getAttribute('data-rotate');
          const period = elements[i].getAttribute('data-period');
          if (rotateData) new TxtRotate(elements[i], JSON.parse(rotateData), period);
        }
      });
    </script>
  </body>
</html>
