---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="ShortYou ฅ•ω•ฅ"
  description="ShortYou is a URL Shortener."
  robots="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
>
  <section class="hero mx-auto w-full max-w-xl text-center">
    <h1 class="hero-title title-font leading-none">
      Just&nbsp;Shorten&nbsp;It
      <span class="block">ヽ(‘ ∇‘ )ノ</span>
    </h1>
    <p class="hero-subtitle title-font text-slate-200">
      <span
        class="txt-rotate"
        data-period="1000"
        data-rotate='["Too Long ? ", "Too Height ? ", "Too Fat ? ", "Too Ugly ? ", "30cm ? "]'
      >You</span>
      Shorten it !
    </p>

    <form id="shortenForm" class="mx-auto w-full max-w-xl space-y-3">
      <div class="url-row">
        <input
          id="url"
          type="text"
          value="https://"
          placeholder="https://purr.tw"
          aria-label="Target URL"
          enterkeyhint="go"
          autocomplete="off"
          class="flat-input url-input"
        />
        <div class="url-actions">
          <button
            id="aliasToggle"
            type="button"
            class="icon-btn"
            aria-label="Toggle custom alias"
            aria-controls="aliasPanel"
            aria-expanded="false"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-4 w-4">
              <circle cx="12" cy="12" r="3.2"></circle>
              <path d="M19.4 15a1 1 0 0 0 .2 1.1l.1.1a2 2 0 0 1 0 2.8 2 2 0 0 1-2.8 0l-.1-.1a1 1 0 0 0-1.1-.2 1 1 0 0 0-.6.9V20a2 2 0 0 1-4 0v-.2a1 1 0 0 0-.7-.9 1 1 0 0 0-1 .2l-.2.1a2 2 0 1 1-2.8-2.8l.1-.1a1 1 0 0 0 .2-1.1 1 1 0 0 0-.9-.6H4a2 2 0 0 1 0-4h.2a1 1 0 0 0 .9-.7 1 1 0 0 0-.2-1l-.1-.2a2 2 0 1 1 2.8-2.8l.1.1a1 1 0 0 0 1.1.2 1 1 0 0 0 .6-.9V4a2 2 0 0 1 4 0v.2a1 1 0 0 0 .7.9 1 1 0 0 0 1-.2l.2-.1a2 2 0 1 1 2.8 2.8l-.1.1a1 1 0 0 0-.2 1.1 1 1 0 0 0 .9.6H20a2 2 0 0 1 0 4h-.2a1 1 0 0 0-.9.7z"></path>
            </svg>
          </button>
          <span class="submit-wrap">
            <button id="btn" type="submit" class="submit-btn" aria-label="Shorten URL" aria-busy="false" disabled>
              <svg class="submit-arrow h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
              <svg class="submit-spinner h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" opacity=".25"></circle><path d="M12 3a9 9 0 0 1 9 9" stroke-linecap="round"></path></svg>
            </button>
            <span class="submit-hint" aria-hidden="true">Shorten URL</span>
          </span>
        </div>
      </div>
      <div id="aliasPanel" class="alias-panel is-collapsed">
        <div id="aliasWrap" class="alias-shell is-disabled">
          <span class="alias-prefix">#</span>
          <input
            id="alias"
            type="text"
            placeholder="Customize link (optional)"
            aria-label="Custom alias"
            autocomplete="off"
            class="alias-input"
          />
        </div>
      </div>

      <details class="mode-hint text-xs text-slate-400">
        <summary id="modeSummary" title="This page returns a mock result and does not call the create API.">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v6m0 4h.01"></path>
          </svg>
          <span id="modeHint">Playground only</span>
        </summary>
        <p id="modeDescription" class="mt-2">This page returns a mock result and does not call the create API.</p>
      </details>
      <div id="turnstileWidget" class="hidden"></div>

      <div id="resultCard" class="result-card hidden">
        <div class="result-link-row">
          <a id="resultLink" class="result-link" aria-live="polite" aria-atomic="true" href="#" target="_blank" rel="noopener noreferrer"></a>
          <div class="result-actions">
            <button id="copyBtn" type="button" class="icon-btn-sm" aria-label="Copy short link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="copy-icon h-4 w-4" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg class="copy-check h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12 4 4 10-10"></path></svg>
            </button>
            <button id="qrBtn" type="button" class="icon-btn-sm" aria-label="Show QR Code">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
                <rect x="2" y="2" width="8" height="8" rx="1"></rect>
                <rect x="14" y="2" width="8" height="8" rx="1"></rect>
                <rect x="2" y="14" width="8" height="8" rx="1"></rect>
                <path d="M14 14h2v2h-2z"></path>
                <path d="M20 14h2v2h-2z"></path>
                <path d="M14 20h2v2h-2z"></path>
                <path d="M20 20h2v2h-2z"></path>
                <path d="M18 17h2v2h-2z"></path>
                <path d="M17 18v2"></path>
              </svg>
            </button>
          </div>
        </div>
        <div id="qrContainer" class="qr-container">
          <canvas id="qrCanvas"></canvas>
        </div>
      </div>
      <p id="resultFeedback" class="sr-only" role="status" aria-live="polite"></p>
    </form>
  </section>

  <div id="redirectOverlay" class="redirect-overlay" slot="afterMain">
    <canvas id="matrixCanvas" class="matrix-canvas"></canvas>
    <div class="redirect-content">
      <p id="redirectLabel" class="redirect-label">resolving</p>
      <p id="redirectAlias" class="redirect-alias" data-text="">#</p>
      <div class="redirect-bar"><div id="redirectBar" class="redirect-bar-fill"></div></div>
      <p id="redirectDest" class="redirect-dest"></p>
    </div>
    <div class="redirect-scanlines"></div>
  </div>

  <div id="toast" class="toast" role="status" aria-live="polite" slot="afterMain"></div>

  <script>
    import { getFrontendConfig } from '../scripts/config';
    import { initIndexPage, showToast } from '../scripts/index-page';

    try {
      initIndexPage(getFrontendConfig());
    } catch {
      document.documentElement.classList.remove('is-redirecting');
      showToast('服務設定或初始化失敗，請稍後再試。', true);
    }
  </script>
</BaseLayout>

<style>
  .hero {
    margin-block: min(2rem, 4dvh);
  }

  .hero-title {
    font-size: min(3.75rem, calc((100vw - 2rem) / 7.5), 12dvh);
    margin-bottom: min(3rem, 5dvh);
  }

  .hero-subtitle {
    font-size: min(1.875rem, calc((100vw - 2rem) / 16), 5dvh);
    margin-bottom: min(1.75rem, 3dvh);
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: min(6rem, 12dvh);
    }

    .hero-subtitle {
      font-size: min(2.25rem, 5dvh);
    }
  }
  @media (max-height: 600px) {
    .hero {
      margin-block: 2dvh;
    }

    .hero-title {
      font-size: min(3.75rem, calc((100vw - 2rem) / 7.5), 8dvh);
      margin-bottom: 2dvh;
    }
  }
</style>
