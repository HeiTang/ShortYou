{
  "name": "shortyou",
  "private": true,
  "version": "1.0.0",
  "description": "ShortYou frontend and GAS backend pipeline",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:gas": "tsc --project tsconfig.json",
    "check:gas": "node --check gas/Code.js && test -f gas/appsscript.json",
    "dev:frontend": "astro dev",
    "build:frontend": "astro build",
    "preview:frontend": "astro preview",
    "build:all": "npm run build:gas && npm run build:frontend"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@types/google-apps-script": "^2.0.8",
    "astro": "^5.10.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
